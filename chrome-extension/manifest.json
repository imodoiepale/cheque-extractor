{
  "manifest_version": 3,
  "name": "Kyriq – QuickBooks Check Reconciliation",
  "short_name": "Kyriq",
  "version": "1.2.14",
  "description": "Clear checks in QuickBooks Online: match scanned and handwritten checks to transactions, approve, and reconcile without leaving QBO.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Kyriq"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.intuit.com/*"
      ],
      "js": [
        "content/reconcile-tick.js",
        "content/qbo-overlay.js"
      ],
      "css": [
        "content/qbo-overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://yqbmzerdagqevjdwhlwh.supabase.co/*",
    "https://quickbooks.api.intuit.com/*",
    "https://check-extractor-production-2026.up.railway.app/*",
    "https://kyriq.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://*.intuit.com/*"
      ]
    }
  ]
}
