{
  "functions": {
    "pages/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/retention/sweep",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/qbo/health-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/email/notices",
      "schedule": "10 8 * * *"
    },
    {
      "path": "/api/billing/report-usage",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/billing/renewal-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
